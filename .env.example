# Copy to .env.local for local development. Never commit real values.

# mock = sample data on the phone (Phase A) · live = Supabase (Phase B, from step B3)
NEXT_PUBLIC_DATA_MODE=mock

# Supabase (Phase B) — Project Settings → API Keys. Publishable key only; never a secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Protects /api/keepalive (Vercel sends it automatically to cron routes). 32+ random hex chars.
CRON_SECRET=


# Lets a stranger create their own account from the sign-in page. Off unless exactly "true".
# Supabase must also allow new sign-ups (Authentication → Sign In / Providers).
NEXT_PUBLIC_SIGNUP_ENABLED=false
